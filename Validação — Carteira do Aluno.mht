@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; background: rgb(16, 20, 20); color: rgb(243, 246, 245); font: 15px / 1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }

.card { width: 100%; max-width: 400px; background: rgb(24, 29, 28); border-radius: 20px; padding: 28px 24px; box-shadow: rgba(0, 0, 0, 0.4) 0px 20px 50px; }

.badge { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }

.dot { width: 14px; height: 14px; border-radius: 50%; background: rgb(15, 157, 110); flex: 0 0 auto; box-shadow: rgba(15, 157, 110, 0.133) 0px 0px 0px 5px; }

h1 { margin: 0px; font-size: 24px; font-weight: 800; letter-spacing: 0.4px; color: rgb(15, 157, 110); }

.sub { margin: 0px 0px 22px; color: rgb(140, 152, 149); font-size: 13px; }

dl { margin: 0px; border-top: 1px solid rgb(42, 49, 48); }

.row { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0px; border-bottom: 1px solid rgb(42, 49, 48); }

dt { color: rgb(140, 152, 149); font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; }

dd { margin: 0px; font-weight: 650; text-align: right; }

.foot { margin: 20px 0px 0px; color: rgb(111, 123, 121); font-size: 11px; text-align: center; line-height: 1.6; }
